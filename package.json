{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "npm run shared:validate && npm run elections:validate && npm run seo:validate",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "npm run build:dev && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "shared:validate": "node --experimental-strip-types scripts/shared/validate-texas-platform.ts",
    "shared:entities:validate": "node --experimental-strip-types scripts/shared/validate-entity-framework.ts",
    "seo:validate": "node scripts/seo/validate.mjs",
    "elections:normalize": "node scripts/elections/normalize-imports.mjs",
    "elections:authority-registry": "node scripts/elections/generate-political-authority-registry.mjs",
    "elections:migrate-sources": "node scripts/elections/migrate-source-urls.mjs",
    "elections:sources": "node scripts/elections/rebuild-sources.mjs",
    "elections:polling-averages": "node --experimental-strip-types scripts/elections/polling-averages.ts",
    "elections:validate:forecast": "node scripts/elections/validate-forecast-pipeline.mjs",
    "elections:validate": "node scripts/elections/validate-enums.mjs && node scripts/elections/validate.mjs && node scripts/elections/validate-sources.mjs && node scripts/elections/validate-political-authority-registry.mjs && npm run elections:validate:forecast",
    "elections:import:races": "node --experimental-strip-types scripts/elections/import-races.ts && npm run elections:normalize",
    "elections:scrape:candidates": "node --experimental-strip-types scripts/elections/scrape-official-candidates.ts",
    "elections:scrape:primary-winners": "node scripts/elections/scrape-official-primary-winners.mjs",
    "elections:import:candidates": "node --experimental-strip-types scripts/elections/import-candidates.ts && npm run elections:normalize && npm run elections:authority-registry",
    "elections:resolve:fec": "node --experimental-strip-types scripts/elections/resolve-fec-ids.ts",
    "elections:import:finance": "node --experimental-strip-types scripts/elections/import-finance.ts",
    "elections:import:polls": "node --experimental-strip-types scripts/elections/import-tpor-may-poll.ts && node --experimental-strip-types scripts/elections/import-ut-june-poll.ts",
    "elections:generate:geography": "node --experimental-strip-types scripts/elections/generate-official-geography.ts",
    "elections:import:geography": "npm run elections:generate:geography && node --experimental-strip-types scripts/elections/import-geography.ts",
    "elections:forecast": "node --experimental-strip-types scripts/elections/forecast.ts && npm run elections:sources && npm run elections:validate:forecast",
    "elections:routes:qa": "node scripts/elections/routes-qa.mjs",
    "elections:sitemap:qa": "node scripts/elections/sitemap-qa.mjs",
    "elections:readiness": "node scripts/elections/launch-readiness.mjs",
    "elections:test:mobile": "playwright test --config=playwright.elections.config.ts",
    "elections:qa": "node scripts/elections/qa.mjs && npm run elections:routes:qa && npm run elections:sitemap:qa && npm run elections:readiness",
    "elections:refresh": "npm run elections:import:races && npm run elections:import:candidates && npm run elections:resolve:fec && npm run elections:import:finance && npm run elections:import:polls && npm run elections:import:geography && npm run elections:normalize && npm run elections:migrate-sources && npm run elections:sources && npm run elections:polling-averages && npm run elections:forecast && npm run elections:validate && npm run elections:qa",
    "legislature:sync": "node scripts/legislature/sync-texas-legislation.mjs",
    "legislature:validate": "node scripts/legislature/validate.mjs",
    "legislature:archive:validate": "node scripts/legislature/validate-local-documents.mjs",
    "legislature:archive:relationships": "node scripts/legislature/validate-document-relationships.mjs",
    "legislature:archive:import": "node scripts/legislature/import-local-documents.mjs",
    "legislature:archive:export-batches": "node scripts/legislature/export-local-document-batches.mjs",
    "legislature:archive:send-batches": "node scripts/legislature/send-document-batches.mjs",
    "legislature:bills:export-batches": "node scripts/legislature/export-local-bill-batches.mjs",
    "legislature:archive:validate-imported": "node scripts/legislature/validate-imported-documents.mjs",
    "legislature:archive:test-parser": "node scripts/legislature/test-official-document-parser.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lovable.dev/email-js": "^0.0.4",
    "@lovable.dev/webhooks-js": "^0.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@stripe/react-stripe-js": "6.2.0",
    "@stripe/stripe-js": "9.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/router-plugin": "^1.168.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-email": "^6.6.5",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stripe": "22.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.8.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "entities": "4.5.0"
    }
  }
}
